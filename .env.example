# Copy to .env and adjust. docker compose reads this file automatically.

# Which profile the API serves. config/offline.yaml needs nothing external.
RAG_CONFIG=config/pgvector.yaml

# Postgres with the pgvector extension.
POSTGRES_USER=kestrel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kestrel
RAG_PG_DSN=postgresql://kestrel:change-me@postgres:5432/kestrel

# Ollama. Pull the models once: make models
OLLAMA_BASE_URL=http://ollama:11434
